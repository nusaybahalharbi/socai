# =====================================================================
# SOC AI Platform — environment template
# Copy this to `.env` at the repo root for docker-compose to pick it up.
# =====================================================================

# --- Mode: "mock" generates synthetic alerts. "splunk" pulls from Splunk.
DATA_MODE=mock

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Mock data generator (DATA_MODE=mock) ---
MOCK_ALERT_INTERVAL_SECONDS=30
MOCK_ALERTS_PER_BATCH=5

# --- Splunk integration (DATA_MODE=splunk) -------------------------------
# When backend runs in Docker and Splunk runs on your Ubuntu VM (or host),
# use host.docker.internal so the container can reach the host network.
# If Splunk is on another VM, set SPLUNK_HOST to that VM's IP.
SPLUNK_HOST=host.docker.internal
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=changeme
SPLUNK_INDEX=main
SPLUNK_POLL_INTERVAL_SECONDS=60
SPLUNK_VERIFY_SSL=false
